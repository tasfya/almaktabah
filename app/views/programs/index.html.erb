<div class="container mx-auto px-4 py-6 max-w-4xl">
  <header class="mb-6">
    <h1 class="text-2xl md:text-3xl font-bold mb-2"><%= t("programs.index.title") %></h1>
    <p class="text-base-content/80"><%= t("programs.index.subtitle") %></p>
  </header>

  <% if @programs.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @programs.each do |program| %>
        <%= link_to program_path(program), class: "card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition" do %>
          <div class="card-body gap-2">
            <h2 class="card-title text-lg"><%= program.title %></h2>
            <% scholars = program.scholars.map(&:name) %>
            <% if scholars.any? %>
              <p class="text-sm text-base-content/80 flex items-center gap-1"><%= icon "user", class: "size-4 shrink-0" %><%= scholars.join("، ") %></p>
            <% end %>
            <%= render "programs/counts", program: program %>
            <% if program.description.present? %>
              <p class="text-base-content/80 text-sm"><%= truncate(program.description, length: 160) %></p>
            <% end %>
            <% cohort = program.cohorts.sort_by(&:starts_on).find(&:enrollment_open?) %>
            <% if cohort %>
              <% zone_today = cohort.today %>
              <p class="text-sm text-base-content/80">
                <%= cohort.starts_on > zone_today ? t("programs.index.next_cohort", date: program_date(cohort.starts_on, zone_today)) : t("programs.index.open_cohort", cohort: cohort.name) %>
              </p>
            <% end %>
            <div class="card-actions items-center justify-between mt-1">
              <% if @enrolled_program_ids.include?(program.id) %>
                <span class="badge badge-success badge-soft"><%= t("programs.index.enrolled") %></span>
              <% end %>
              <span class="btn btn-primary btn-sm min-h-11 ms-auto"><%= t("programs.index.details") %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-base-content/80"><%= t("programs.index.empty") %></p>
  <% end %>
</div>

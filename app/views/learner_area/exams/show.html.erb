<% slot = @progress.slot_for(@item) %>
<% has_questions = @exam.questions.any? %>
<% draft_key = "exam-draft:#{@enrollment.id}:#{@exam.id}" %>
<%# Back after submitting must fetch the result, not restore the form from Turbo's cache. %>
<% turbo_exempts_page_from_cache %>
<div class="container mx-auto px-4 py-6 max-w-3xl">
  <%= render "programs/flash" %>

  <header class="mb-4">
    <p class="text-sm text-base-content/70"><%= @cohort.program.title %></p>
    <h1 class="text-xl md:text-2xl font-bold leading-tight mb-2"><%= exam_title(@item) %></h1>
    <% if has_questions %>
      <p class="text-sm font-semibold"><%= t("programs.exam.summary", questions: arabic_count("programs.counts.questions", @exam.questions.size)) %></p>
      <p class="text-sm text-base-content/80"><%= exam_window(slot, @cohort, @progress.today) %></p>
      <p class="text-xs text-base-content/80"><%= t("programs.cohort.time_zone", zone: cohort_time_zone_name(@cohort)) %></p>
    <% end %>
  </header>

  <% if @exam.description.present? %>
    <div class="prose prose-sm max-w-none mb-4"><%= simple_format(@exam.description) %></div>
  <% end %>

  <% case @state %>
  <% when :open %>
    <div role="note" class="rounded-box border border-amber-300 bg-amber-50 text-amber-950 text-sm p-4 mb-4 flex flex-col items-start gap-1">
      <span class="font-semibold"><%= t("programs.exam.deadline", time: program_deadline(slot.closes_at, @cohort, @progress.today)) %></span>
      <span><%= t("programs.exam.one_attempt") %></span>
    </div>
    <%= form_with url: submit_learner_cohort_exam_path(@cohort, @exam), method: :post, class: "flex flex-col gap-4",
          data: { controller: "exam", action: "change->exam#change submit->exam#submit",
                  exam_key_value: draft_key,
                  exam_answered_template_value: learner_t("programs.exam.answered", answered: "%{answered}", total: "%{total}"),
                  exam_confirm_value: learner_t("programs.exam.confirm"),
                  exam_confirm_unanswered_value: learner_t("programs.exam.confirm_unanswered", count: "%{count}", numbers: "%{numbers}") } do %>
      <% @questions.each_with_index do |question, index| %>
        <fieldset id="<%= dom_id(question) %>" data-exam-target="question" data-number="<%= index + 1 %>"
                  class="group bg-base-100 border border-base-300 rounded-xl p-4 scroll-mt-24 data-[unanswered]:border-2 data-[unanswered]:border-red-700">
          <legend class="float-start w-full font-semibold"><%= index + 1 %>. <%= question.body %></legend>
          <p class="clear-both hidden group-data-[unanswered]:block text-sm font-semibold text-red-700 pt-1"><%= learner_t("programs.exam.unanswered") %></p>
          <div class="clear-both flex flex-col gap-2 pt-2">
            <% question.choices.each do |choice| %>
              <label class="flex items-start gap-3 cursor-pointer rounded-lg p-2 min-h-11 hover:bg-base-200 has-[:checked]:bg-primary/10">
                <%= radio_button_tag "answers[#{question.id}]", choice.id, false, class: "radio radio-primary radio-sm mt-1" %>
                <span><%= choice.body %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      <div class="sticky bottom-0 z-10 -mx-4 px-4 py-3 bg-base-100/95 border-t border-base-300 flex flex-wrap items-center gap-x-4 gap-y-2">
        <%= button_tag t("programs.exam.submit"), type: "submit", class: "btn btn-primary",
              data: { turbo_submits_with: t("programs.exam.submitting") } %>
        <p class="text-sm tabular-nums" data-exam-target="answered"></p>
        <p role="timer" hidden class="text-sm tabular-nums w-full sm:w-auto"
           data-controller="countdown"
           data-countdown-closes-at-value="<%= (slot.closes_at.to_f * 1000).to_i %>"
           data-countdown-now-value="<%= (@progress.at.to_f * 1000).to_i %>"
           data-countdown-template-value="<%= t("programs.exam.time_left", time: "%{time}") %>"
           data-countdown-short-template-value="<%= learner_t("programs.exam.time_short", time: "%{time}") %>"
           data-countdown-up-value="<%= t("programs.exam.time_up") %>"></p>
      </div>
    <% end %>
  <% when :submitted %>
    <div hidden data-controller="exam" data-exam-key-value="<%= draft_key %>" data-exam-clear-value="true"></div>
    <% pass_mark = @cohort.program.pass_mark %>
    <% passed = @attempt.passed?(pass_mark) %>
    <div class="card bg-base-100 border border-base-300 shadow-sm mb-4">
      <div class="card-body items-center text-center gap-1">
        <p class="text-3xl font-bold"><%= t("programs.exam.result", score: @attempt.score_percent) %></p>
        <p class="<%= passed ? "text-green-800" : "text-red-700" %> font-semibold">
          <%= passed ? learner_t("programs.exam.passed") : learner_t("programs.exam.failed", pass_mark: pass_mark) %>
        </p>
        <% unless passed %>
          <p class="text-sm"><%= t("programs.exam.certificate_lost") %></p>
        <% end %>
      </div>
    </div>
    <% chosen = @attempt.attempt_answers.to_h { |answer| [ answer.question_id, answer.choice_id ] } %>
    <%= render "learner_area/exams/answers", questions: @questions, chosen: chosen, reveal: true %>
  <% when :late %>
    <div hidden data-controller="exam" data-exam-key-value="<%= draft_key %>" data-exam-clear-value="true"></div>
    <%= render "learner_area/exams/answers", questions: @questions, chosen: @late_choices, reveal: false %>
  <% when :missed %>
    <div hidden data-controller="exam" data-exam-key-value="<%= draft_key %>" data-exam-clear-value="true"></div>
    <div role="status" class="alert alert-soft flex flex-col items-start gap-1">
      <%= exam_status(@progress, @item, {}) %>
      <span class="text-sm"><%= t("programs.exam.certificate_lost") %></span>
    </div>
  <% else %>
    <div role="status" class="alert alert-soft"><%= exam_status(@progress, @item, {}) %></div>
  <% end %>

  <div class="mt-6">
    <%= link_to t("programs.exam.back"), learner_cohort_path(@cohort), class: "btn btn-ghost btn-sm" %>
  </div>
</div>

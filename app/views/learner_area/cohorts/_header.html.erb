<%# locals: (cohort:, progress:, certificate:) %>
<header id="cohort_header" class="mb-4">
  <p class="text-sm text-base-content/70"><%= cohort.name %></p>
  <h1 class="text-xl md:text-2xl font-bold leading-tight mb-3"><%= cohort.program.title %></h1>
  <%= render "learner_area/cohorts/progress", progress: progress, id: "cohort_progress" %>
  <% if certificate && !certificate.revoked? %>
    <div role="status" class="alert alert-success mt-4">
      <%= icon "check-badge", class: "size-5" %>
      <span><%= t("programs.cohort.certificate_issued", number: certificate.number) %></span>
    </div>
  <% else %>
    <% step = learner_next_step(progress) %>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-box bg-base-200 p-3">
      <p class="flex-1 min-w-48 font-semibold"><%= step[:text] %></p>
      <% if step[:item] %>
        <%= link_to t(step[:item].exam? ? "programs.dashboard.go_to_exam" : "programs.dashboard.go_to_item"), "##{dom_id(step[:item])}",
              class: "btn btn-primary btn-sm min-h-11" %>
      <% end %>
    </div>
  <% end %>
  <p class="text-xs text-base-content/70 mt-2"><%= t("programs.cohort.time_zone", zone: cohort_time_zone_name(cohort)) %></p>
</header>

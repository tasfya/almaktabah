<div class="container mx-auto px-4 py-6 max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h1 class="text-2xl font-bold"><%= t("programs.dashboard.title") %></h1>
    <div class="flex items-center gap-2">
      <%= link_to t("programs.account.link"), learner_account_path, class: "btn btn-ghost btn-sm min-h-11" %>
      <%= button_to t("programs.dashboard.sign_out"), destroy_learner_session_path, method: :delete, class: "btn btn-ghost btn-sm min-h-11" %>
    </div>
  </div>
  <%= render "programs/flash" %>
  <p class="font-semibold mb-4"><%= t("programs.dashboard.greeting", name: current_learner.full_name) %></p>

  <% if @progresses.any? %>
    <div class="flex flex-col gap-4">
      <% @progresses.each do |progress| %>
        <% cohort = progress.enrollment.cohort %>
        <% certificate = progress.enrollment.certificate %>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body gap-3">
            <div>
              <p class="text-sm text-base-content/70"><%= cohort.name %></p>
              <h2 class="card-title text-lg"><%= cohort.program.title %></h2>
            </div>
            <%= render "learner_area/cohorts/progress", progress: progress, id: "enrollment_#{progress.enrollment.id}_progress" %>
            <% if certificate && !certificate.revoked? %>
              <p class="font-semibold"><%= t("programs.cohort.certificate_issued", number: certificate.number) %></p>
              <% step = {} %>
            <% else %>
              <% step = learner_next_step(progress) %>
              <p class="font-semibold"><%= step[:text] %></p>
            <% end %>
            <div class="card-actions justify-end">
              <% if step[:item] %>
                <%= link_to t(step[:item].exam? ? "programs.dashboard.go_to_exam" : "programs.dashboard.go_to_item"),
                      learner_cohort_path(cohort, anchor: dom_id(step[:item])), class: "btn btn-primary btn-sm min-h-11" %>
                <%= link_to t("programs.dashboard.open_cohort"), learner_cohort_path(cohort), class: "btn btn-ghost btn-sm min-h-11" %>
              <% else %>
                <%= link_to t("programs.dashboard.open_cohort"), learner_cohort_path(cohort), class: "btn btn-primary btn-sm min-h-11" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body">
        <p class="text-base-content/80"><%= learner_t("programs.dashboard.empty") %></p>
        <div class="card-actions"><%= link_to t("programs.dashboard.browse"), programs_path, class: "btn btn-primary btn-sm min-h-11" %></div>
      </div>
    </div>
  <% end %>
</div>

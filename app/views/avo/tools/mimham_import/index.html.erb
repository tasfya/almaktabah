<%= content_tag :div, class: "flex flex-col space-y-6" do %>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Mimham CSV Import</h1>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_tag "/avo/tools/mimham_import/import", method: :post, multipart: true, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">CSV File</label>
        <%= file_field_tag :csv_file, accept: ".csv", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
        <p class="mt-1 text-xs text-gray-500">Expected columns: title, scholar_name, kind, category, source_url, audio_url, published_at</p>
      </div>

      <div class="flex items-center space-x-6">
        <label class="flex items-center">
          <%= check_box_tag :dry_run, "1", true, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
          <span class="ml-2 text-sm text-gray-700">Dry Run (preview only, no changes)</span>
        </label>

        <label class="flex items-center">
          <%= check_box_tag :download_audio, "1", false, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
          <span class="ml-2 text-sm text-gray-700">Download Audio Files</span>
        </label>
      </div>

      <div>
        <%= submit_tag "Import", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @result.present? %>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold mb-4">
        <%= @dry_run ? "Dry Run Report" : "Import Report" %>
      </h2>

      <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="bg-green-50 rounded-lg p-4">
          <div class="text-2xl font-bold text-green-700"><%= @result[:would_create_count] || @result[:created_count] %></div>
          <div class="text-sm text-green-600"><%= @dry_run ? "Would Create" : "Created" %></div>
        </div>
        <div class="bg-yellow-50 rounded-lg p-4">
          <div class="text-2xl font-bold text-yellow-700"><%= @result[:existing_count] %></div>
          <div class="text-sm text-yellow-600">Already Exist</div>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="text-2xl font-bold text-gray-700"><%= @result[:skipped_count] %></div>
          <div class="text-sm text-gray-600">Skipped</div>
        </div>
        <div class="bg-red-50 rounded-lg p-4">
          <div class="text-2xl font-bold text-red-700"><%= @result[:errors].size %></div>
          <div class="text-sm text-red-600">Errors</div>
        </div>
      </div>

      <% if @result[:existing_records].present? %>
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Existing Records (would be skipped)</h3>
          <div class="bg-yellow-50 rounded-lg p-4 max-h-64 overflow-y-auto">
            <ul class="space-y-1 text-sm">
              <% @result[:existing_records].first(50).each do |record| %>
                <li class="text-yellow-800">
                  <span class="font-medium">[<%= record[:scholar_name] %>]</span>
                  <%= record[:title] %>
                </li>
              <% end %>
              <% if @result[:existing_records].size > 50 %>
                <li class="text-yellow-600 italic">... and <%= @result[:existing_records].size - 50 %> more</li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <% if @result[:new_records].present? %>
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">
            <%= @dry_run ? "New Records (would be imported)" : "Imported Records" %>
          </h3>
          <div class="bg-green-50 rounded-lg p-4 max-h-64 overflow-y-auto">
            <ul class="space-y-1 text-sm">
              <% @result[:new_records].first(50).each do |record| %>
                <li class="text-green-800">
                  <span class="font-medium">[<%= record[:scholar_name] %>]</span>
                  <%= record[:title] %>
                  <span class="text-green-600">(<%= record[:kind] %>)</span>
                </li>
              <% end %>
              <% if @result[:new_records].size > 50 %>
                <li class="text-green-600 italic">... and <%= @result[:new_records].size - 50 %> more</li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <% if @result[:errors].present? %>
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 mb-2">Errors</h3>
          <div class="bg-red-50 rounded-lg p-4 max-h-64 overflow-y-auto">
            <ul class="space-y-1 text-sm">
              <% @result[:errors].first(50).each do |error| %>
                <li class="text-red-800"><%= error %></li>
              <% end %>
              <% if @result[:errors].size > 50 %>
                <li class="text-red-600 italic">... and <%= @result[:errors].size - 50 %> more</li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<!DOCTYPE html>
<html dir="rtl" lang="ar">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin:0;padding:0;background:#f5f5f4;">
    <div dir="rtl" style="max-width:560px;margin:0 auto;padding:24px 16px;font-family:Tahoma,Arial,sans-serif;font-size:16px;line-height:1.8;color:#1c1917;text-align:right;">
      <p style="margin:0 0 16px;font-size:18px;font-weight:bold;"><%= @domain&.title %></p>
      <div style="background:#ffffff;border-radius:8px;padding:20px;">
        <%= yield %>
      </div>
      <% if content_for?(:footer) %>
        <div style="margin-top:16px;font-size:13px;color:#57534e;">
          <%= yield :footer %>
        </div>
      <% end %>
    </div>
  </body>
</html>

<div class="container mx-auto px-4 py-8">
  <div class="card bg-base-100 border border-base-300 shadow-sm max-w-md mx-auto">
    <div class="card-body gap-5">
      <div class="text-center">
        <h1 class="text-2xl font-bold"><%= title %></h1>
        <% if local_assigns[:subtitle] %>
          <p class="text-sm opacity-70 mt-1"><%= subtitle %></p>
        <% end %>
      </div>
      <% flash.each do |type, message| %>
        <% next if type.to_s == "reminders_saved_for" %>
        <div role="<%= type.to_s == "alert" ? "alert" : "status" %>" class="alert <%= flash_alert_class(type) %> alert-soft text-sm"><%= message %></div>
      <% end %>
      <% if (pending = pending_enrollment_cohort) && %w[sessions registrations].include?(controller_name) %>
        <div role="status" class="alert alert-info alert-soft text-sm">
          <%= t("programs.learner_auth.pending_enrollment.#{controller_name}", program: pending.program.title, cohort: pending.name) %>
        </div>
      <% end %>
      <%= yield %>
    </div>
  </div>
</div>

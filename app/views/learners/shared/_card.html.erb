<div class="container mx-auto px-4 py-8">
  <div class="card bg-base-100 border border-base-300 shadow-sm max-w-md mx-auto">
    <div class="card-body gap-5">
      <div class="text-center">
        <h1 class="text-2xl font-bold"><%= title %></h1>
        <% if local_assigns[:subtitle] %>
          <p class="text-sm opacity-70 mt-1"><%= subtitle %></p>
        <% end %>
      </div>
      <% flash.each do |type, message| %>
        <div role="alert" class="alert <%= type.to_s == "notice" ? "alert-success" : "alert-error" %> alert-soft text-sm"><%= message %></div>
      <% end %>
      <%= yield %>
    </div>
  </div>
</div>
